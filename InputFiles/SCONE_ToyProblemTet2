type eigenPhysicsPackage;

pop      100000;
active   50;
inactive 50;
XSdata ce;
dataType ce;
seed 1;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorDT; }

inactiveTally {}

activeTally {
	display (k_eff);
        k_eff { type keffAnalogClerk;}
}

geometry {
	type geometryStd;
  	boundary (2 2 2 2 2 2);
  	graph {type shrunk;}

  	surfaces {
		boxContainer { id 1; type box; origin (0.0 0.0 0.0); halfwidth (0.631 0.631 0.301); }
  	}

	cells {
   		hostCell {id 1; type simpleCell; surfaces (-1); filltype mat; material water;}
  	}

	meshes { 
		testMesh {id 1; type OpenFOAMMesh; path ./IntegrationTestFiles/Geometry/Meshes/OpenFOAM/FinalFuelPinTet137/; accelerationMethod patchSingle;}
	}

	universes {
    		root { id 1; type rootUniverse; border 1; fill u<2>; }
		mesh { id 2; type meshUniverse; origin (0.0 0.0 0.0); rotation (0.0 0.0 0.0); cell 1; mesh 1; fills (fuel water); }
  	}

}



nuclearData {
	handles {
    		ce {type aceNeutronDatabase; aceLibrary $SCONE_ACE ;}
  	}

	materials {

		water {
      			temp 75675;
      			rgb (0 0 139); // Colour of water is dark blue
      			moder { 1001.03 (hh2o.09); }
      			composition {
      				1001.03    6.700E-002;
      				8016.03    3.350E-002;
			}
      		}

    		fuel {
      			temp 87476;
       			composition {
                    92235.03 9.0336E-004;   // 235U number density [atoms/b·cm]
                    92238.03 2.14069E-002;  // 238U number density
                    8016.03  4.46205E-002;  // Oxygen (assumed all 16O)
			}
      		}

	}
}
