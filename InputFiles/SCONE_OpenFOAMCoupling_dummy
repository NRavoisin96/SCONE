type eigenPhysicsPackage;

pop      200000;
cycles   500;
inactive 50;
XSdata ce;
dataType ce;
seed 1;

collisionOperator { neutronCE {type neutronCEstd;} }

transportOperator { type transportOperatorDT; cache 0; }

inactiveTally {

}

activeTally 
{
    clerks 
    {
    	display (keff);
        fissionPower
        {
            type trackClerk;
            map {
                type unstructuredMeshMap;
                meshId 1;
            }
            response (fissionPower);
            fissionPower {
                type fissionPowerResponse;
            }
        }
        keff
        {
        	type keffAnalogClerk;
        }
    }
    normalisationMethod {
        type volumeNormalisationMethod;
        targetValue 200000.0;
        normalisationClerk fissionPower;
    }
}

geometry {
	type geometryStd;
	graph {type shrunk;}
	boundary (1 1 1 1 1 1);
	
	cells {
   		hostCell {id 1; type simpleCell; surfaces (-1); filltype mat; material water;}
  	}
  	
  	fields {
  		T
	    {
	        type mixedScalarField;
	        meshFields {
	            squareRod {
	                type OpenFOAMScalarField;
	                meshId 1;
	                path /home/parallels/Desktop/Academic/SCONE/IntegrationTestFiles/Fields/ScalarFields/T;
	            }
	        }
	    }
  	}

	meshes { 
		squareRod {
		    id 1;
		    type OpenFOAMMesh;
		    path /home/parallels/Desktop/Academic/SCONE/IntegrationTestFiles/Geometry/Meshes/OpenFOAM/squareRod/;
		    localIds {
		        assignmentMethod all;
		    }
		    fills (fuel);
