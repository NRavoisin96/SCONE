type eigenPhysicsPackage;

pop      200;
cycles   200;
inactive 100;
XSdata ce;
dataType ce;
seed 3;

collisionOperator { neutronCE {type neutronCEstd;}
                    neutronMG {type neutronMGstd;} }

transportOperator { type transportOperatorDT; cache 0; }

inactiveTally {}

activeTally {
	clerks {
		display (k_eff);
		k_eff {
			type keffAnalogClerk;
		}
	}
}

geometry {
	type geometryStd;
  	boundary (1 1 1 1 1 1);
  	graph {type shrunk;}

  	surfaces {
		boxContainer { id 1; type box; origin (0.0 0.0 0.0); halfwidth (12000.0 12000.0 12000.0); }
  	}

	cells {
   		hostCell {id 1; type simpleCell; surfaces (-1); filltype mat; material water;}
  	}

	meshes { 
		testMesh {
		    id 1;
		    type OpenFOAMMesh;
		    path ./IntegrationTestFiles/Geometry/Meshes/OpenFOAM/StanfordBunny_LowPoly/;
		    localIds {
		    	assignmentMethod all;
		    }
		    fills (fuel);
		}
	}

	universes {
    	root { id 1; type rootUniverse; border 1; fill u<2>; }
		mesh { id 2; type meshUniverse; origin (0.0 0.0 0.0); rotation (0.0 0.0 0.0); cell 1; mesh 1; fills (fuel); }
  	}

}

nuclearData {
	handles {
    	ce {type aceNeutronDatabase; aceLibrary $SCONE_ACE;}
  	}
  
	materials {

		water {
      			temp 75675;
      			rgb (0 0 139); // Colour of water is dark blue
      			moder { 1001.03 (hh2o.09); }
      			composition {
      				1001.03    6.700E-002;
      				8016.03    3.350E-002;
      				5010.03    5.560E-006;
      				5011.03    2.224E-005; 
			    }
      		}

    	fuel {
      		temp 87476;
       		composition {
      			92235.03  1.450E-003;
      			92238.03  4.690E-002;
			}
      	}
	}
}
